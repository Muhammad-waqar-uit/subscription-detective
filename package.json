{
  "name": "subscription-detective",
  "displayName": "Subscription Detective",
  "version": "0.1.0",
  "description": "Detects free trials and subscriptions as you sign up, reminds you before you are charged, and keeps everything on your device.",
  "author": "Muhammad Waqar",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .js,.jsx",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\" \"*.{js,mjs,json}\""
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "date-fns": "^4.4.0",
    "plasmo": "^0.90.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "vitest": "^5.0.5"
  },
  "manifest": {
    "name": "Subscription Detective",
    "short_name": "Sub Detective",
    "minimum_chrome_version": "116",
    "permissions": [
      "storage",
      "alarms",
      "notifications"
    ]
  }
}
